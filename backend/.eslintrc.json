{
  "root": true,
  "env": { "node": true, "es2021": true },
  "parserOptions": { "ecmaVersion": 2021, "sourceType": "module" },
  "ignorePatterns": ["dist", "node_modules"],
  "rules": {
    "no-console": "off",
    "eqeqeq": ["error", "smart"],
    "no-var": "error",
    "prefer-const": "error"
  }
}
